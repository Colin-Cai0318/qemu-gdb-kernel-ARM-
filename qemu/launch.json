{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "kernel debug",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/vmlinux",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "targetArchitecture": "arm64",
      "stopAtConnect": true,
      "miDebuggerPath": "__KERNEL_GDB__",
      "miDebuggerServerAddress": "localhost:1234",
      "preLaunchTask": "Start QEMU",
      "setupCommands": [
        {
          "description": "辅助脚本读取类型前先加载 vmlinux",
          "text": "file \"${workspaceFolder}/vmlinux\"",
          "ignoreFailures": false
        },
        {
          "description": "加载内核和外部模块调试支持",
          "text": "source ${workspaceFolder}/.vscode/kernel-lab.gdb",
          "ignoreFailures": false
        }
      ]
    }
  ]
}
